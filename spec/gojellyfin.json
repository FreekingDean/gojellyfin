  "components": {
    "schemas": {
      "SourceTestRequest": {
        "type": "object",
        "required": [
          "Kind",
          "Url",
          "ApiKeyVariable"
        ],
        "properties": {
          "Kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "Url": {
            "type": "string",
            "description": "Base address of the instance, without a trailing slash."
          },
          "ApiKeyVariable": {
            "type": "string",
            "description": "Name of the environment variable holding the API key. Must begin with SOURCE_API_KEY_."
          }
        }
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "Sonarr",
          "Radarr",
          "Lidarr"
        ]
      },
      "Sources": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Source"
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "Name": {
            "type": "string"
          },
          "Kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "Url": {
            "type": "string",
            "description": "Base address of the instance, without a trailing slash."
          },
          "ApiKeyVariable": {
            "type": "string",
            "description": "Name of the environment variable holding the API key. Must begin with SOURCE_API_KEY_."
          },
          "Libraries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceLibrary"
            }
          },
          "Paths": {
            "type": "array",
            "description": "Where each folder the instance reports is opened on this server.",
            "items": {
              "$ref": "#/components/schemas/SourcePath"
            }
          },
          "Version": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Version the instance last reported."
          },
          "ContactedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "readOnly": true,
            "description": "When the instance last answered."
          },
          "LastError": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Why the instance last failed to answer, empty once it does."
          },
          "Requests": {
            "$ref": "#/components/schemas/SourceRequests"
          },
          "Files": {
            "type": "integer",
            "format": "int32",
            "readOnly": true,
            "description": "How many files the instance reported, across every root folder."
          }
        }
      },
      "SourceTestResult": {
        "type": "object",
        "required": [
          "Reachable"
        ],
        "properties": {
          "Reachable": {
            "type": "boolean"
          },
          "Error": {
            "type": "string",
            "nullable": true
          },
          "Version": {
            "type": "string",
            "nullable": true
          },
          "RootFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "QualityProfiles": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/SourceQualityProfile"
            }
          },
          "Tags": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SourceLibrary": {
        "type": "object",
        "required": [
          "Id"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "TagFilter": {
            "type": "string",
            "nullable": true
          },
          "LastSyncedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "readOnly": true
          },
          "LastError": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "SourcePath": {
        "type": "object",
        "required": [
          "RemotePath",
          "LocalPath"
        ],
        "properties": {
          "RemotePath": {
            "type": "string",
            "description": "A folder the instance reports its files under."
          },
          "LocalPath": {
            "type": "string",
            "description": "Where this server opens that folder."
          }
        }
      },
      "SourceError": {
        "type": "object",
        "required": [
          "Message"
        ],
        "properties": {
          "Message": {
            "type": "string"
          }
        }
      },
      "SourceRequests": {
        "type": "object",
        "nullable": true,
        "description": "Where a title somebody asks for is added on the instance. Absent means the instance takes no requests.",
        "required": [
          "QualityProfileId",
          "RootFolder"
        ],
        "properties": {
          "QualityProfileId": {
            "type": "integer",
            "format": "int32",
            "description": "The instance's own id for the quality profile a requested title is given."
          },
          "RootFolder": {
            "type": "string",
            "description": "The folder on the instance a requested title is added under."
          },
          "Tag": {
            "type": "string",
            "nullable": true,
            "description": "A tag the instance puts on a requested title, so a library that filters on it shows what arrives."
          }
        }
      },
      "SourceQualityProfile": {
        "type": "object",
        "required": [
          "Id",
          "Name"
        ],
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "RequestedTitles": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RequestedTitle"
        }
      },
      "RequestedTitle": {
        "type": "object",
        "required": [
          "ItemId",
          "Name",
          "Kind",
          "Requests",
          "Submissions"
        ],
        "properties": {
          "ItemId": {
            "type": "string",
            "format": "uuid",
            "description": "The id the title is opened by while the library lacks it."
          },
          "Name": {
            "type": "string"
          },
          "Kind": {
            "type": "string",
            "description": "Movie or Series."
          },
          "Requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestEntry"
            }
          },
          "Submissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestSubmission"
            }
          }
        }
      },
      "RequestEntry": {
        "type": "object",
        "required": [
          "Id",
          "UserId",
          "UserName",
          "Status",
          "CreatedAt"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "UserName": {
            "type": "string"
          },
          "Status": {
            "type": "string",
            "description": "Pending, Approved or Declined."
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RequestSubmission": {
        "type": "object",
        "required": [
          "SourceName"
        ],
        "properties": {
          "SourceName": {
            "type": "string"
          },
          "AcceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the instance took the title. Absent while it has refused."
          },
          "Error": {
            "type": "string",
            "nullable": true,
            "description": "What the instance said the last time it refused."
          }
        }
      },
      "RequestUsers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RequestUser"
        }
      },
      "RequestUser": {
        "type": "object",
        "required": [
          "Id",
          "Name",
          "Used",
          "CanRequest",
          "NeedsApproval"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Used": {
            "type": "integer",
            "format": "int32",
            "description": "How many titles the user asked for in the last seven days."
          },
          "CanRequest": {
            "type": "boolean"
          },
          "NeedsApproval": {
            "type": "boolean",
            "description": "Whether an administrator approves each request before a downloader is asked."
          },
          "Quota": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "The most titles the user may ask for in seven days. Absent means no limit."
          }
        }
      },
      "RequestAllowance": {
        "type": "object",
        "required": [
          "CanRequest",
          "NeedsApproval"
        ],
        "properties": {
          "CanRequest": {
            "type": "boolean"
          },
          "NeedsApproval": {
            "type": "boolean"
          },
          "Quota": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "Reports": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Report"
        }
      },
      "Report": {
        "type": "object",
        "required": [
          "Id",
          "ItemId",
          "ItemName",
          "Kind",
          "Origin",
          "Note",
          "Status",
          "CreatedAt",
          "Replaceable"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "ItemId": {
            "type": "string",
            "format": "uuid"
          },
          "ItemName": {
            "type": "string",
            "description": "The title, with its series and numbers when it is an episode."
          },
          "Kind": {
            "type": "string",
            "description": "Unplayable, Video, Audio, Subtitles or Other."
          },
          "Origin": {
            "type": "string",
            "description": "User, Delete, Probe or Playback."
          },
          "Note": {
            "type": "string"
          },
          "Status": {
            "type": "string",
            "description": "Open, Resolved or Dismissed."
          },
          "UserName": {
            "type": "string",
            "nullable": true,
            "description": "Who reported it. Absent when the server did."
          },
          "Path": {
            "type": "string",
            "nullable": true,
            "description": "The file the report names, when it names one."
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "Replaceable": {
            "type": "boolean",
            "description": "Whether a downloader names a file for the title, so another copy can be asked for."
          }
        }
      },
      "ReportFiling": {
        "type": "object",
        "required": [
          "ItemId",
          "Kind"
        ],
        "properties": {
          "ItemId": {
            "type": "string",
            "format": "uuid"
          },
          "Kind": {
            "type": "string",
            "description": "Unplayable, Video, Audio, Subtitles or Other."
          },
          "Note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Settings": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Setting"
        }
      },
      "Setting": {
        "type": "object",
        "required": [
          "Name",
          "Value",
          "Set",
          "Secret"
        ],
        "properties": {
          "Name": {
            "type": "string",
            "description": "The environment variable."
          },
          "Value": {
            "type": "string",
            "description": "What it is set to. Always empty for a secret."
          },
          "Set": {
            "type": "boolean",
            "description": "Whether the variable holds a value."
          },
          "Secret": {
            "type": "boolean",
            "description": "Whether the value is withheld."
          }
        }
      },
      "ShelfChoices": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ShelfChoice"
        }
      },
      "ShelfChoice": {
        "type": "object",
        "required": [
          "Slug",
          "Name",
          "Enabled"
        ],
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Enabled": {
            "type": "boolean"
          }
        }
      },
      "ShelfSelection": {
        "type": "object",
        "required": [
          "Enabled"
        ],
        "properties": {
          "Enabled": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The slugs of the shelves that are on."
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "Ok",
          "Warn",
          "Bad",
          "Off"
        ],
        "description": "Ok works, Warn works with something to look at, Bad does not work, Off is not configured."
      },
      "HealthCheck": {
        "type": "object",
        "required": [
          "Name",
          "Status",
          "Detail"
        ],
        "properties": {
          "Name": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "Detail": {
            "type": "string",
            "description": "What was found, or what to set."
          },
          "At": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When what Detail describes happened, for a downloader the last time it answered."
          }
        }
      },
      "HealthLibrary": {
        "type": "object",
        "required": [
          "Movies",
          "Shows",
          "Episodes",
          "Unprobed",
          "Unidentified"
        ],
        "properties": {
          "Movies": {
            "type": "integer",
            "format": "int32"
          },
          "Shows": {
            "type": "integer",
            "format": "int32"
          },
          "Episodes": {
            "type": "integer",
            "format": "int32"
          },
          "Unprobed": {
            "type": "integer",
            "format": "int32",
            "description": "Files ffprobe has not read since they last changed."
          },
          "Unidentified": {
            "type": "integer",
            "format": "int32",
            "description": "Titles with no provider ids or no artwork yet."
          },
          "RefreshedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When a downloader was last read successfully."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "Checks",
          "Library"
        ],
        "properties": {
          "Checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheck"
            }
          },
          "Library": {
            "$ref": "#/components/schemas/HealthLibrary"
          }
        }
      }
    },
    "securitySchemes": {
      "CustomAuthentication": {
        "type": "apiKey",
        "description": "API key header parameter",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
