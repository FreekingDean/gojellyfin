    "/GoJellyfin/Reports/{reportId}/Replace": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Deletes the reported file on its downloader, blocklists the release it came from and searches for another.",
        "operationId": "GoJellyfinReplaceReported",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
