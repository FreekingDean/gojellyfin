{
  "openapi": "3.0.4",
  "info": {
    "title": "gojellyfin API",
    "description": "Operations gojellyfin serves that the Jellyfin API has no vocabulary for.",
    "version": "0.1.0"
  },
  "paths": {
    "/GoJellyfin/Sources": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Lists every configured Sonarr and Radarr instance.",
        "operationId": "GoJellyfinListSources",
        "responses": {
          "200": {
            "description": "The configured sources.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sources"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "Sources"
        ],
        "summary": "Adds a Sonarr or Radarr instance.",
        "operationId": "GoJellyfinCreateSource",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Source"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Source saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          },
          "400": {
            "description": "The source was refused, and why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      }
    },
    "/GoJellyfin/Sources/{sourceId}": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Gets one source.",
        "operationId": "GoJellyfinGetSource",
        "parameters": [
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "description": "The source id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The source.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          },
          "404": {
            "description": "No such source."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      },
      "put": {
        "tags": [
          "Sources"
        ],
        "summary": "Replaces one source's configuration.",
        "operationId": "GoJellyfinUpdateSource",
        "parameters": [
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "description": "The source id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Source"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Source saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          },
          "400": {
            "description": "The source was refused, and why.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceError"
                }
              }
            }
          },
          "404": {
            "description": "No such source."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Sources"
        ],
        "summary": "Removes one source, along with every file it reported.",
        "operationId": "GoJellyfinDeleteSource",
        "parameters": [
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "description": "The source id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Source removed."
          },
          "404": {
            "description": "No such source."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      }
    },
    "/GoJellyfin/Sources/Test": {
      "post": {
        "tags": [
          "Sources"
        ],
        "summary": "Tests a Sonarr or Radarr instance and lists its root folders.",
        "operationId": "GoJellyfinTestSource",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The instance answered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceTestResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      }
    },
    "/GoJellyfin/SourceApiKeyVariables": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Lists the SOURCE_API_KEY_ variables set on this server, by name only.",
        "operationId": "GoJellyfinListSourceApiKeyVariables",
        "responses": {
          "200": {
            "description": "The variable names.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SourceTestRequest": {
        "type": "object",
        "required": [
          "Kind",
          "Url",
          "ApiKeyVariable"
        ],
        "properties": {
          "Kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "Url": {
            "type": "string",
            "description": "Base address of the instance, without a trailing slash."
          },
          "ApiKeyVariable": {
            "type": "string",
            "description": "Name of the environment variable holding the API key. Must begin with SOURCE_API_KEY_."
          }
        }
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "Sonarr",
          "Radarr"
        ]
      },
      "Sources": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Source"
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "Name": {
            "type": "string"
          },
          "Kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "Url": {
            "type": "string",
            "description": "Base address of the instance, without a trailing slash."
          },
          "ApiKeyVariable": {
            "type": "string",
            "description": "Name of the environment variable holding the API key. Must begin with SOURCE_API_KEY_."
          },
          "Libraries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceLibrary"
            }
          },
          "Paths": {
            "type": "array",
            "description": "Where each folder the instance reports is opened on this server.",
            "items": {
              "$ref": "#/components/schemas/SourcePath"
            }
          },
          "Version": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Version the instance last reported."
          },
          "ContactedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "readOnly": true,
            "description": "When the instance last answered."
          },
          "LastError": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "description": "Why the instance last failed to answer, empty once it does."
          },
          "Requests": {
            "$ref": "#/components/schemas/SourceRequests"
          }
        }
      },
      "SourceTestResult": {
        "type": "object",
        "required": [
          "Reachable"
        ],
        "properties": {
          "Reachable": {
            "type": "boolean"
          },
          "Error": {
            "type": "string",
            "nullable": true
          },
          "Version": {
            "type": "string",
            "nullable": true
          },
          "RootFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "QualityProfiles": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/SourceQualityProfile"
            }
          },
          "Tags": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SourceLibrary": {
        "type": "object",
        "required": [
          "Id"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "TagFilter": {
            "type": "string",
            "nullable": true
          },
          "LastSyncedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "readOnly": true
          },
          "LastError": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "SourcePath": {
        "type": "object",
        "required": [
          "RemotePath",
          "LocalPath"
        ],
        "properties": {
          "RemotePath": {
            "type": "string",
            "description": "A folder the instance reports its files under."
          },
          "LocalPath": {
            "type": "string",
            "description": "Where this server opens that folder."
          }
        }
      },
      "SourceError": {
        "type": "object",
        "required": [
          "Message"
        ],
        "properties": {
          "Message": {
            "type": "string"
          }
        }
      },
      "SourceRequests": {
        "type": "object",
        "nullable": true,
        "description": "Where a title somebody asks for is added on the instance. Absent means the instance takes no requests.",
        "required": [
          "QualityProfileId",
          "RootFolder"
        ],
        "properties": {
          "QualityProfileId": {
            "type": "integer",
            "format": "int32",
            "description": "The instance's own id for the quality profile a requested title is given."
          },
          "RootFolder": {
            "type": "string",
            "description": "The folder on the instance a requested title is added under."
          },
          "Tag": {
            "type": "string",
            "nullable": true,
            "description": "A tag the instance puts on a requested title, so a library that filters on it shows what arrives."
          }
        }
      },
      "SourceQualityProfile": {
        "type": "object",
        "required": [
          "Id",
          "Name"
        ],
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "CustomAuthentication": {
        "type": "apiKey",
        "description": "API key header parameter",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
