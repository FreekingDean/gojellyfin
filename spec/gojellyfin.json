{
  "openapi": "3.0.4",
  "info": {
    "title": "gojellyfin API",
    "description": "Operations gojellyfin serves that the Jellyfin API has no vocabulary for.",
    "version": "0.1.0"
  },
  "paths": {
    "/GoJellyfin/Sources": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Lists the sources configuration.",
        "operationId": "GoJellyfinListSources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sources"
                }
              }
            },
            "description": "Source saved."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      },
      "put": {
        "tags": [
          "Sources"
        ],
        "summary": "Updates the sources configuration.",
        "operationId": "GoJellyfinUpdateSources",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Sources"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Source saved."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      }
    },
    "/GoJellyfin/Sources/Test": {
      "post": {
        "tags": [
          "Sources"
        ],
        "summary": "Tests whether a Sonarr or Radarr instance is reachable.",
        "operationId": "GoJellyfinTestSource",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The instance answered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceTestResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "CustomAuthentication": [
              "DefaultAuthorization",
              "RequiresElevation"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SourceTestRequest": {
        "type": "object",
        "required": [
          "Kind",
          "Url",
          "ApiKeyVariable"
        ],
        "properties": {
          "Kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "Url": {
            "type": "string",
            "description": "Base address of the instance, without a trailing slash."
          },
          "ApiKeyVariable": {
            "type": "string",
            "description": "Name of the environment variable holding the API key. Must begin with SOURCE_API_KEY_."
          }
        }
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "Sonarr",
          "Radarr"
        ]
      },
      "Sources": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Source"
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "Url": {
            "type": "string",
            "description": "Base address of the instance, without a trailing slash."
          },
          "ApiKeyVariable": {
            "type": "string",
            "description": "Name of the environment variable holding the API key. Must begin with SOURCE_API_KEY_."
          },
          "Libraries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceLibrary"
            }
          }
        }
      },
      "SourceTestResult": {
        "type": "object",
        "required": [
          "Reachable"
        ],
        "properties": {
          "Reachable": {
            "type": "boolean"
          },
          "Error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SourceLibrary": {
        "type": "object",
        "required": [
          "Id"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "TagFilter": {
            "type": "string",
            "nullable": true
          },
          "SourcePath": {
            "type": "string",
            "nullable": true,
            "description": "Path prefix as Sonarr or Radarr reports it."
          },
          "TargetPath": {
            "type": "string",
            "nullable": true,
            "description": "Path prefix this server opens the file at."
          }
        }
      }
    },
    "securitySchemes": {
      "CustomAuthentication": {
        "type": "apiKey",
        "description": "API key header parameter",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
