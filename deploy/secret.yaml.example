# Copy this to a secret.yaml kept outside the repository, fill it in and apply
# it before the rest of deploy/. The .example suffix is what keeps
# `kubectl apply -f deploy/` from overwriting the real values with these
# placeholders: kubectl only reads .yaml, .yml and .json out of a directory.
apiVersion: v1
kind: Secret
metadata:
  name: gojellyfin
  labels:
    app.kubernetes.io/name: gojellyfin
type: Opaque
stringData:
  # Read by internal/store/fx.go, and only by the API and the migrate Job. The
  # transcoders are deliberately not given this key: `gojellyfin transcoder`
  # "needs the media mounted at the same paths the API sees and no database at
  # all", so credentials there would only widen what a compromised encoder can
  # reach.
  DATABASE_URL: postgres://gojellyfin:REPLACE_ME@postgres:5432/gojellyfin?sslmode=require

  # Shared by the API (internal/transcode/pool.go) and every transcoder
  # (internal/transcode/worker/worker.go), sent as the X-Transcoder-Token
  # header. A transcode request names a path for ffmpeg to open, so a worker
  # with an empty token will read any file it can reach for anyone who can
  # dial it — the check is skipped entirely when the value is empty.
  TRANSCODER_TOKEN: REPLACE_ME
